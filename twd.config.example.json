{
  "url": "http://localhost:5173",
  "timeout": 10000,
  "coverage": true,
  "coverageDir": "./coverage",
  "nycOutputDir": "./.nyc_output",
  "headless": true,
  "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
  "protocolTimeout": 300000,
  "record": {
    "enabled": false,
    "dir": "./twd-artifacts",
    "filename": null,
    "format": "mp4",
    "viewport": { "width": 1280, "height": 720, "deviceScaleFactor": 1 },
    "fps": 30,
    "speed": 1,
    "hideSidebar": true,
    "ffmpegPath": "ffmpeg"
  }
}
