{
  "name": "twd-cli",
  "version": "1.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BRIKEV/twd-cli.git"
  },
  "description": "CLI tool for running TWD tests with Puppeteer",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "twd-cli": "./bin/twd-cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest --run --coverage",
    "conventional-changelog": "conventional-changelog -i CHANGELOG.md",
    "execute:cli": "node ./bin/twd-cli.js",
    "lock:linux": "docker run --rm -v \"$PWD\":/app -w /app node:24 npm install --package-lock-only"
  },
  "keywords": [
    "twd",
    "testing",
    "cli",
    "puppeteer",
    "browser-testing"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "istanbul-lib-coverage": "^3.2.2",
    "openapi-mock-validator": "^0.3.0",
    "puppeteer": "^25.10.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
